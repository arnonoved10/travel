// ==========================================================================
// travel-app — Prisma schema (שלב 0)
// כל ההחלטות המפורטות ב-01_architecture_v2.md + הבהרות ההודעה השלישית
// של המשתמש (Planned Activity/Booking/Expense/Payment נפרדים, Place גלובלי
// + TripPlace, Soft Delete, Audit Log, Time Zones, Base Currency, מקור מידע)
// ==========================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  // "native" בשביל הרצה מקומית (Windows), "rhel-openssl-3.0.x" בשביל ה-
  // runtime בפועל של Vercel Serverless Functions — שונה מה-runtime של
  // מכונת ה-build עצמה, ולכן חייב להיות מפורש כאן ולא מוסק אוטומטית.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL עובר דרך ה-Transaction Pooler של Supabase (IPv4) — לא
  // חיבור-ישיר. נמצא ואומת 2026-08-27: db.<ref>.supabase.co הישיר עונה רק
  // ב-IPv6 (אין רשומת A בכלל), ו-Vercel Serverless Functions הן IPv4-בלבד —
  // כל שאילתה נכשלה עם "Can't reach database server" עד שהוחלף ל-Pooler.
  url       = env("DATABASE_URL")
  // DIRECT_URL (ל-migrate/introspect בלבד, לא לשאילתות בזמן-ריצה) — Session
  // Pooler, גם הוא IPv4, כדי שמיגרציות יעבדו גם מסביבה בלי IPv6.
  directUrl = env("DIRECT_URL")
}

